@model ICatalog

@{
    ViewData["Title"] = _.T("Create a new catalog");
}

<h3>@ViewBag.Title</h3>

<div ng-controller="CatalogController">
    <form method="post">
        <div class="row">
            <div class="col-md-6">
                <h3>@_.T("Culture")</h3>
                <div class="form-group">
                    <label asp-for="Culture" class="control-label"></label>
                    <input id="Culture" ng-model="Culture" class="form-control" />
                </div>

                <hr />

                <h3>@_.Tx("Catalog", "Headers")</h3>

                <div class="form-group">
                    <table class="table table-condensed">
                        <tr ng-repeat="hdr in current.headers">
                            <td>
                                <input ng-model=""/>
                            </td>
                        </tr>
                    </table>

                    <label asp-for="Culture" class="control-label"></label>
                    <input id="Culture" ng-model="Culture" class="form-control" />
                </div>

                <div class="form-group">
                    <label asp-for="Culture" class="control-label"></label>
                    <input asp-for="Culture" class="form-control" />
                    <span asp-validation-for="Culture" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Culture" class="control-label"></label>
                    <input asp-for="Culture" class="form-control" />
                    <span asp-validation-for="Culture" class="text-danger"></span>
                </div>

            </div>
        </div>
        <dl class="dl-horizontal">
            <dt>@_.T("Culture")</dt>
            <dd>
                <input asp-for="Culture" class="form-control" />
            </dd>

            <dt>@_.Tx("Catalog", "Headers")</dt>
            <dd>
                <ul class="list-unstyled">
                    @foreach (var hdr in Model.Headers)
                    {
                        <li>@hdr.Key : <strong>@hdr.Value</strong> </li>
                    }
                </ul>
            </dd>

            <dt>@_.T("Plural Count")</dt>
            <dd>@Model.PluralCount</dd>
        </dl>

        <button type="submit" class="btn btn-primary">
            <i class="fa fa-save"></i> @_.T("Create catalog")
        </button>
        @Html.AntiForgeryToken()
    </form>
</div>
